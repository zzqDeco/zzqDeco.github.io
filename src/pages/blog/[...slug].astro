---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GiscusComments from '../../components/GiscusComments.astro';
import { CalendarDays, Tags, TableOfContents } from 'lucide-astro';
import { render } from 'astro:content';
import { formatBlogDateTime } from '../../lib/date';
import { getBlogTagHref, getVisibleBlogPosts } from '../../lib/blog';
import { markdownHasMath } from '../../lib/math';
import katexCssUrl from 'katex/dist/katex.min.css?url';

export async function getStaticPaths() {
  const posts = await getVisibleBlogPosts();

  return posts.map((post) => {
    if (post.body === undefined) {
      // glob loader 当前恒有 body；若未来更换 loader 导致缺失，宁可构建失败
      // 也不能静默按"无公式"处理而丢失 KaTeX CSS
      throw new Error(`Blog post "${post.id}" has no body; cannot determine hasMath.`);
    }

    return {
      params: { slug: post.id },
      props: { post, hasMath: markdownHasMath(post.body) },
    };
  });
}

const { post, hasMath } = Astro.props;
const { Content, headings } = await render(post);
const pubDate = formatBlogDateTime(post.data.pubDate);
const updated = post.data.updatedDate ? formatBlogDateTime(post.data.updatedDate) : undefined;
const tocHeadings = headings.filter((heading) => heading.depth <= 3);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  image={post.data.image}
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString()}
>
  {hasMath && (
    <Fragment slot="head">
      <link rel="stylesheet" href={katexCssUrl} />
      {/* 行间公式溢出保护（原 global.css 规则，仅随 KaTeX 页面加载） */}
      <style is:inline>
        .article-body .katex-display { overflow-x: auto; overflow-y: hidden; padding: var(--space-2) 0; }
      </style>
    </Fragment>
  )}
  <article class:list={['article-page', tocHeadings.length > 0 && 'has-toc']}>
    <header class="article-head">
      <nav class="crumbs" aria-label="breadcrumbs">
        <a href="/">~</a>
        <span class="sep">/</span>
        <a href="/blog/">blog</a>
      </nav>

      <h1 class="article-title">{post.data.title}</h1>
      {post.data.description && (
        <p class="article-description">{post.data.description}</p>
      )}

      <div class="article-meta" aria-label="文章元信息">
        <span>
          <CalendarDays size={14} strokeWidth={1.8} aria-hidden="true" />
          <time datetime={post.data.pubDate.toISOString()}>{pubDate}</time>
        </span>
        {updated && <span>更新于 {updated}</span>}
        {post.data.tags.length > 0 && (
          <span class="article-tags">
            <Tags size={14} strokeWidth={1.8} aria-hidden="true" />
            {post.data.tags.map((tag) => <a href={getBlogTagHref(tag)}>{tag}</a>)}
          </span>
        )}
      </div>
    </header>

    {tocHeadings.length > 0 && (
      <aside class="toc-panel panel" aria-label="目录" data-toc-panel>
        <p class="toc-head">
          <TableOfContents size={15} strokeWidth={1.8} aria-hidden="true" />
          sections
        </p>
        <ol>
          {tocHeadings.map((heading) => (
            <li class={`toc-depth-${heading.depth}`}>
              <a href={`#${heading.slug}`} data-toc-link={heading.slug}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </aside>
    )}

    <div class="article-body panel">
      <Content />
    </div>

    <GiscusComments />
  </article>

  {tocHeadings.length > 0 && (
    <script>
      (() => {
        const tocPanel = document.querySelector<HTMLElement>('[data-toc-panel]');
        const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
        if (!tocPanel || tocLinks.length === 0) return;

        const entries = tocLinks
          .map((link) => {
            const slug = link.dataset.tocLink;
            const target = slug ? document.getElementById(slug) : null;
            return target ? { link, target } : null;
          })
          .filter((item): item is { link: HTMLAnchorElement; target: HTMLElement } => item !== null);

        if (entries.length === 0) return;

        let activeLink: HTMLAnchorElement | null = null;
        let ticking = false;

        const updateActiveHeading = () => {
          ticking = false;
          const threshold = 136;
          let current = entries[0];

          for (const entry of entries) {
            if (entry.target.getBoundingClientRect().top <= threshold) {
              current = entry;
            } else {
              break;
            }
          }

          if (activeLink === current.link) return;

          if (activeLink) {
            activeLink.classList.remove('is-active');
          }
          current.link.classList.add('is-active');
          activeLink = current.link;

          if (
            window.getComputedStyle(tocPanel).position === 'sticky' &&
            tocPanel.scrollHeight > tocPanel.clientHeight
          ) {
            const linkTop = current.link.offsetTop;
            const linkBottom = linkTop + current.link.offsetHeight;
            const viewTop = tocPanel.scrollTop + 24;
            const viewBottom = tocPanel.scrollTop + tocPanel.clientHeight - 24;

            if (linkTop < viewTop) {
              tocPanel.scrollTo({ top: Math.max(0, linkTop - 24), behavior: 'smooth' });
            } else if (linkBottom > viewBottom) {
              tocPanel.scrollTo({
                top: linkBottom - tocPanel.clientHeight + 24,
                behavior: 'smooth',
              });
            }
          }
        };

        const onScroll = () => {
          if (!ticking) {
            window.requestAnimationFrame(updateActiveHeading);
            ticking = true;
          }
        };

        updateActiveHeading();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
      })();
    </script>
  )}
</BaseLayout>
