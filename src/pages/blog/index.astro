---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogArchiveView from '../../components/BlogArchiveView.astro';
import {
  createBlogPage,
  getBlogPageHref,
  getBlogTags,
  getVisibleBlogPosts,
  groupBlogPostsByArchive,
} from '../../lib/blog';

const posts = await getVisibleBlogPosts();
const page = createBlogPage(posts, 1, getBlogPageHref);
const allTags = getBlogTags(posts);
const archiveGroups = groupBlogPostsByArchive(page.data);
const summary = `${page.total} entries sorted by pubDate desc. Page ${page.currentPage} / ${page.lastPage}. Markdown remains the source of truth; production filters drafts.`;
---

<BaseLayout title="文章" description="zzqDeco Blog 文章列表">
  <BlogArchiveView
    heading="文章归档"
    terminalCommand="find ./src/content/blog -type f | sort --reverse"
    summary={summary}
    tags={allTags}
    archiveGroups={archiveGroups}
    page={page}
  />
</BaseLayout>
