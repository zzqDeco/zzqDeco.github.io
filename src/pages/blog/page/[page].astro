---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogArchiveView from '../../../components/BlogArchiveView.astro';
import {
  createBlogPage,
  getBlogPageHref,
  getBlogTags,
  getVisibleBlogPosts,
  groupBlogPostsByArchive,
} from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getVisibleBlogPosts();
  const firstPage = createBlogPage(posts, 1, getBlogPageHref);

  return Array.from({ length: Math.max(0, firstPage.lastPage - 1) }, (_, index) => {
    const currentPage = index + 2;
    const page = createBlogPage(posts, currentPage, getBlogPageHref);

    return {
      params: { page: String(currentPage) },
      props: {
        page,
        tags: getBlogTags(posts),
        archiveGroups: groupBlogPostsByArchive(page.data),
      },
    };
  });
}

const { page, tags, archiveGroups } = Astro.props;
const summary = `共 ${page.total} 篇 · 第 ${page.currentPage} / ${page.lastPage} 页`;
---

<BaseLayout title={`文章 - 第 ${page.currentPage} 页`} description="zzqDeco Blog 文章列表">
  <BlogArchiveView
    heading="文章归档"
    summary={summary}
    tags={tags}
    archiveGroups={archiveGroups}
    page={page}
  />
</BaseLayout>
