---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostEntry from '../components/PostEntry.astro';
import { ArrowRight, FileText, Rss, Terminal, UserRound } from 'lucide-astro';
import { getVisibleBlogPosts, getBlogTagHref } from '../lib/blog';
import { formatBlogDateTime } from '../lib/date';

const posts = await getVisibleBlogPosts();

const [featurePost, ...restPosts] = posts;
const latestPosts = restPosts.slice(0, 4);
---

<BaseLayout title="首页" description="zzqDeco Blog 首页">
  <section class="home-hero" aria-label="介绍">
    <div class="hero-console">
      <p class="terminal-line">
        <Terminal size={16} strokeWidth={1.8} aria-hidden="true" />
        <span class="prompt">$</span>
        <span>whoami --focus</span>
      </p>

      <h1 class="hero-title">Tech &amp; Life<br />for <em>Future</em></h1>
      <p class="hero-lede">
        从工作开始重新记录自己，努力成为一个合格的 Full-Stack AI Engineer &amp; Researcher
      </p>

      <div class="hero-actions" aria-label="快捷链接">
        <a class="button-link button-link-primary" href="/blog/">
          <FileText size={16} strokeWidth={1.8} aria-hidden="true" />
          read posts
          <ArrowRight size={15} strokeWidth={1.8} aria-hidden="true" />
        </a>
        <a class="button-link" href="/about/">
          <UserRound size={16} strokeWidth={1.8} aria-hidden="true" />
          about me
        </a>
        <a class="button-link" href="/rss.xml">
          <Rss size={16} strokeWidth={1.8} aria-hidden="true" />
          rss
        </a>
      </div>
    </div>
  </section>

  {featurePost && (
    <section class="feature" aria-label="最新文章">
      <p class="feature-micro">Latest</p>
      <div class="feature-head">
        <h2 class="feature-title">
          <a href={`/blog/${featurePost.id}/`} data-astro-prefetch>{featurePost.data.title}</a>
        </h2>
        <time class="feature-date" datetime={featurePost.data.pubDate.toISOString()}>
          {formatBlogDateTime(featurePost.data.pubDate)}
        </time>
      </div>
      {featurePost.data.description && (
        <p class="feature-summary">{featurePost.data.description}</p>
      )}
      {featurePost.data.tags.length > 0 && (
        <div class="feature-tags post-entry-tags" aria-label="标签">
          {featurePost.data.tags.map((tag) => <a href={getBlogTagHref(tag)}>{tag}</a>)}
        </div>
      )}
    </section>
  )}

  <section class="section-stack" aria-label="最近文章">
    <div class="section-head">
      <p class="section-label">recent posts</p>
      <a class="section-action" href="/blog/">
        view archive
        <ArrowRight size={14} strokeWidth={1.8} aria-hidden="true" />
      </a>
    </div>

    <ol class="post-list">
      {latestPosts.map((post) => (
        <PostEntry post={post} />
      ))}
    </ol>
  </section>
</BaseLayout>
