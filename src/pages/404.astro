---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FileText, Home, Terminal } from 'lucide-astro';
---

<BaseLayout
  title="404"
  description="你访问的页面不存在或已被移动。"
  showProfile={false}
  noindex={true}
>
  <section class="home-hero" aria-label="404">
    <div class="hero-console panel">
      <nav class="crumbs" aria-label="breadcrumbs">
        <a href="/">~</a>
        <span class="sep">/</span>
        <span>404</span>
      </nav>

      <div class="terminal-block">
        <p class="terminal-line">
          <Terminal size={16} strokeWidth={1.8} aria-hidden="true" />
          <span class="prompt">$</span>
          <span>cd ./nowhere</span>
        </p>
        <p class="terminal-line terminal-output">
          <span>cd: no such file or directory: ./nowhere</span>
        </p>
      </div>

      <h1 class="hero-title">404: Not Found</h1>
      <p class="hero-lede">你访问的页面不存在、已被移动，或者从未存在过。</p>

      <div class="hero-actions" aria-label="快捷链接">
        <a class="button-link button-link-primary" href="/">
          <Home size={16} strokeWidth={1.8} aria-hidden="true" />
          cd ~/
        </a>
        <a class="button-link" href="/blog/">
          <FileText size={16} strokeWidth={1.8} aria-hidden="true" />
          ls ./blog
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .terminal-block {
    display: grid;
    gap: var(--space-2);
  }

  .terminal-output {
    color: var(--danger);
  }
</style>
