---
import { ArrowLeft, ArrowRight, CalendarDays, Hash, Terminal } from 'lucide-astro';
import type { BlogPage, BlogTag, BlogYearGroup } from '../lib/blog';
import PostEntry from './PostEntry.astro';

interface Props {
  heading: string;
  terminalCommand: string;
  summary: string;
  tags: BlogTag[];
  archiveGroups: BlogYearGroup[];
  page: BlogPage;
  activeTagSlug?: string;
  emptyMessage?: string;
}

const {
  heading,
  terminalCommand,
  summary,
  tags,
  archiveGroups,
  page,
  activeTagSlug,
  emptyMessage = 'No entries matched this view.',
} = Astro.props;

// tag rail 收敛：按 count 降序取前 8；当前激活标签不在前 8 时强制并入，其余收进 details
const sortedTags = [...tags].sort(
  (a, b) => b.count - a.count || a.name.localeCompare(b.name, 'zh-CN')
);
const topTags = sortedTags.slice(0, 8);
const activeTag = activeTagSlug ? sortedTags.find((tag) => tag.slug === activeTagSlug) : undefined;
const visibleTags =
  activeTag && !topTags.some((tag) => tag.slug === activeTag.slug)
    ? [...topTags, activeTag]
    : topTags;
const visibleSlugs = new Set(visibleTags.map((tag) => tag.slug));
const overflowTags = sortedTags.filter((tag) => !visibleSlugs.has(tag.slug));
---

<header class="archive-hero" aria-label={heading}>
  <p class="terminal-line">
    <Terminal size={16} strokeWidth={1.8} aria-hidden="true" />
    <span class="prompt">$</span>
    <span>{terminalCommand}</span>
  </p>
  <h1>{heading}</h1>
  <p>{summary}</p>

  {tags.length > 0 && (
    <div class="tag-rail" aria-label="全部标签">
      <span class="tag-rail-label">
        <Hash size={14} strokeWidth={1.8} aria-hidden="true" />
        tags
      </span>
      {visibleTags.map((tag) => (
        <a
          class:list={['tag-chip', tag.slug === activeTagSlug && 'is-active']}
          href={tag.href}
          aria-current={tag.slug === activeTagSlug ? 'page' : undefined}
        >
          <span>{tag.name}</span>
          <span class="tag-count">{tag.count}</span>
        </a>
      ))}
      {overflowTags.length > 0 && (
        <details class="tag-rail-details">
          <summary class="tag-rail-more">还有 {overflowTags.length} 个标签 →</summary>
          <div class="tag-rail-rest">
            {overflowTags.map((tag) => (
              <a
                class:list={['tag-chip', tag.slug === activeTagSlug && 'is-active']}
                href={tag.href}
                aria-current={tag.slug === activeTagSlug ? 'page' : undefined}
              >
                <span>{tag.name}</span>
                <span class="tag-count">{tag.count}</span>
              </a>
            ))}
          </div>
        </details>
      )}
    </div>
  )}
</header>

{archiveGroups.length > 0 ? (
  <section class="archive-timeline" aria-label="文章列表">
    {archiveGroups.map((yearGroup) => (
      <section class="archive-year" aria-labelledby={`archive-${activeTagSlug ?? 'all'}-${yearGroup.year}`}>
        <h2 id={`archive-${activeTagSlug ?? 'all'}-${yearGroup.year}`}>{yearGroup.year}</h2>

        {yearGroup.months.map((monthGroup) => (
          <div class="archive-month">
            <div class="archive-month-label">
              <CalendarDays size={15} strokeWidth={1.8} aria-hidden="true" />
              <span>{monthGroup.label}</span>
            </div>

            <ol class="post-list archive-list">
              {monthGroup.posts.map((post) => (
                <PostEntry post={post} />
              ))}
            </ol>
          </div>
        ))}
      </section>
    ))}
  </section>
) : (
  <p class="empty-state">{emptyMessage}</p>
)}

{page.lastPage > 1 && (
  <nav class="pagination-nav" aria-label="文章分页">
    {page.url.prev ? (
      <a class="pagination-control" href={page.url.prev}>
        <ArrowLeft size={14} strokeWidth={1.8} aria-hidden="true" />
        prev
      </a>
    ) : (
      <span class="pagination-control is-disabled" aria-disabled="true">
        <ArrowLeft size={14} strokeWidth={1.8} aria-hidden="true" />
        prev
      </span>
    )}

    <ol class="pagination-pages">
      {page.pagination.map((item) => (
        <li>
          {item.type === 'gap' ? (
            <span class="pagination-gap" aria-hidden="true">…</span>
          ) : item.current ? (
            <span class="pagination-page is-current" aria-current="page">{item.number}</span>
          ) : (
            <a class="pagination-page" href={item.href} aria-label={`第 ${item.number} 页`}>
              {item.number}
            </a>
          )}
        </li>
      ))}
    </ol>

    {page.url.next ? (
      <a class="pagination-control" href={page.url.next}>
        next
        <ArrowRight size={14} strokeWidth={1.8} aria-hidden="true" />
      </a>
    ) : (
      <span class="pagination-control is-disabled" aria-disabled="true">
        next
        <ArrowRight size={14} strokeWidth={1.8} aria-hidden="true" />
      </span>
    )}
  </nav>
)}
