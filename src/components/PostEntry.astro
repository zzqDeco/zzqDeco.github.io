---
import type { CollectionEntry } from 'astro:content';
import { formatBlogDateTime } from '../lib/date';
import { getBlogTagHref } from '../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

const visibleTags = post.data.tags.slice(0, 3);
const hiddenTagCount = post.data.tags.length - visibleTags.length;
---

<li class="post-entry">
  <div class="post-entry-row">
    <h3 class="post-entry-title"><a href={`/blog/${post.id}/`} data-astro-prefetch>{post.data.title}</a></h3>
    <time class="post-date" datetime={post.data.pubDate.toISOString()}>
      {formatBlogDateTime(post.data.pubDate)}
    </time>
  </div>
  {post.data.description && (
    <p class="post-entry-summary">{post.data.description}</p>
  )}
  {visibleTags.length > 0 && (
    <div class="post-entry-tags" aria-label="标签">
      {visibleTags.map((tag) => <a href={getBlogTagHref(tag)}>{tag}</a>)}
      {hiddenTagCount > 0 && <span class="tag-more">+{hiddenTagCount}</span>}
    </div>
  )}
</li>
