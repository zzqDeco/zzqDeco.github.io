---
import '../styles/global.css';
import Header from '../components/Header.astro';
import ProfileSidebar from '../components/ProfileSidebar.astro';

interface Props {
  title?: string;
  description?: string;
  /** og:type，文章页传 'article'，其余页面用默认 'website' */
  ogType?: 'article' | 'website';
  showProfile?: boolean;
  noindex?: boolean;
  /** 分享图路径（如 /images/xxx.png），缺省回退站点默认分享图 */
  image?: string;
  /** 文章发布时间（ISO 格式），仅 og:type=article 时输出 */
  publishedTime?: string;
  /** 文章修改时间（ISO 格式），仅 og:type=article 时输出 */
  modifiedTime?: string;
}

const siteName = 'zzqDeco Blog';
const siteDescription = 'zzqDeco 的个人博客';
const defaultShareImage = '/images/og-default.png';

const {
  title,
  description = siteDescription,
  ogType = 'website',
  showProfile = true,
  noindex = false,
  image,
  publishedTime,
  modifiedTime,
} = Astro.props;

const fullTitle = title ? `${title} | ${siteName}` : siteName;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image ?? defaultShareImage, Astro.site);
const ogImageAlt = image ? fullTitle : `${siteName} 默认分享图`;

const today = new Date().toISOString().slice(0, 10);
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const displayPath = pathname === '/' ? '~/blog' : `~${pathname}`;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;700&family=JetBrains+Mono:wght@400;600;700&display=swap"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f1f3f7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#070a0f" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <script is:inline>
      (() => {
        const storageKey = 'theme';
        // 禁用存储时访问 window.localStorage 本身也会抛异常，需整体包 try/catch
        let storedTheme = null;
        try {
          storedTheme = window.localStorage.getItem(storageKey);
        } catch {
          // 静默降级为仅内存状态
        }
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = storedTheme ?? (prefersDark ? 'dark' : 'light');
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>

    <div class="site-frame">
      <Header siteName={siteName} currentPath={pathname} displayPath={displayPath} />

      <div class:list={['ide-shell', showProfile && 'has-profile']}>
        {showProfile && <ProfileSidebar />}

        <main id="main-content" class="content-shell" tabindex="-1">
          <slot />
        </main>
      </div>

      <footer class="status-bar" aria-label="site status">
        <span class="status-pill">
          <span class="status-dot" aria-hidden="true"></span>
          online
        </span>
        <span>{displayPath}</span>
        <span>Astro static</span>
        <span>zh-cn</span>
        <time datetime={today}>{today}</time>
      </footer>
    </div>
  </body>
</html>
